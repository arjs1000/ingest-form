# Ports (block 8300-8309, registered in ~/Developer/.claude/rules/port-registry.md)
BE_PORT=8300
FE_PORT=8301
DB_STUDIO_PORT=8302
DB_PORT=8303
WORKER_DEV_PORT=8304
NODE_ENV=development

# Database (required for anything that touches Prisma)
# Local Postgres (via Docker): postgresql://ingest:ingest_dev@localhost:8303/ingest_form
# Neon (cloud):                postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://ingest:ingest_dev@localhost:8303/ingest_form

# CORS: pipe-separated list of allowed web origins
ALLOWED_ORIGINS=http://localhost:8301

# Frontend API URL
# Leave empty in local dev: Vite proxies /api to BE_PORT.
# Set to the deployed API origin for production builds (baked in at build time).
VITE_API_URL=

# Ingest
# Postcode geocoder used by the geocode step (free, no key)
POSTCODES_IO_BASE_URL=https://api.postcodes.io

# Document OCR (optional): the local PaddleOCR sidecar, started with `pnpm ocr:start`.
# Without it only PDFs with their own text are read. See README "Setting up AI OCR".
# OCR_SIDECAR_URL=http://127.0.0.1:8307
# OCR_SIDECAR_TIMEOUT_MS=120000

# Email, FEAT-003 (optional; success and failure emails are skipped unless the key and sender are set).
# Recipients are not env vars: an admin sets them in Admin → General.
# RESEND_API_KEY=
# A sender on a domain verified in Resend. Resend's shared onboarding@resend.dev only delivers to your own account address.
# RESEND_FROM_EMAIL="Bookable <notifications@yourdomain.com>"
# Admin panel origin, for the link in each email
# ADMIN_BASE_URL=http://localhost:8301

# File storage — Cloudflare R2 (TBD, not wired yet)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Auth (TBD, provider not chosen yet)

# Cloudflare Worker secrets are NOT read from this file.
# Local `wrangler dev` reads apps/api/.dev.vars; deployed secrets use `wrangler secret put <NAME>`.
