<mxCell id="ui" value="&lt;b&gt;Patient web app&lt;/b&gt;&lt;br&gt;POST /api/v1/intake&lt;br&gt;no key (FEAT-002)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#f0f4f5;strokeColor=#4c6272;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="uirl" value="&lt;b&gt;rateLimit(intakeIpLimiter)&lt;/b&gt;&lt;br&gt;10 / 60 s, runs first&lt;br&gt;same 429" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#e8f1fa;strokeColor=#005eb8;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="uibl" value="&lt;b&gt;bodyLimit&lt;/b&gt;&lt;br&gt;64 KB&lt;br&gt;same 413" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#e8f1fa;strokeColor=#005eb8;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="480" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="uisub" value="&lt;b&gt;IntakeService.submit&lt;/b&gt;&lt;br&gt;withReference: adds &lt;font face=&quot;Courier New&quot;&gt;UIF-######-YYYY&lt;/font&gt; when missing&lt;br&gt;submissions.create({ source: 'ui', rawBody }), status = received" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#4c6272;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1020" y="480" width="570" height="110" as="geometry"/></mxCell>
<mxCell id="e_ui_rl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="ui" target="uirl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_rl_bl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="uirl" target="uibl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_bl_sub" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="uibl" target="uisub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="laneB" value="2. Pipeline: ingest/pipeline/run-pipeline.ts, steps in ingest/steps/" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=2;fillColor=none;strokeColor=#aeb7bd;dashed=1;align=left;verticalAlign=top;fontStyle=1;fontColor=#4c6272;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="1880" height="700" as="geometry"/></mxCell>
<mxCell id="runner" value="&lt;b&gt;createPipelineRunner().run(submissionId) → execute(submission, 0, rawBody)&lt;/b&gt;&lt;br&gt;status = processing, failedStep = null. For each step: step.input.safeParse → step.run(input, deps) → submissions.recordStepRun({ step, attempt, status, output, issues, durationMs })" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#4c6272;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="710" width="1810" height="80" as="geometry"/></mxCell>
<mxCell id="e_recv_run" value="pipeline.run(id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.9282;entryY=0;" edge="1" parent="1" source="recv" target="runner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_uisub_run" value="pipeline.run(id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.6713;entryY=0;" edge="1" parent="1" source="uisub" target="runner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s1" value='&lt;b&gt;1 · validate&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;01-validate.step.ts&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;validateStep&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;string → ingestPayloadSchema&lt;/font&gt;&lt;br&gt;&lt;br&gt;JSON.parse, Zod, date of birth plausible (≤ 120 years)&lt;br&gt;&lt;br&gt;&lt;font color="#d5281b"&gt;E: INVALID_JSON, REQUIRED, INVALID_TYPE, INVALID_FORMAT, INVALID_VALUE, DATE_OF_BIRTH_IN_FUTURE, DATE_OF_BIRTH_IMPLAUSIBLE&lt;/font&gt;&lt;br&gt;&lt;font color="#8a5a00"&gt;W: APPLICATION_REFERENCE_FORMAT&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="830" width="260" height="320" as="geometry"/></mxCell>
<mxCell id="s2" value='&lt;b&gt;2 · normalise&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;02-normalise.step.ts&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;normaliseStep&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;ingestPayloadSchema → normalisedPayloadSchema&lt;/font&gt;&lt;br&gt;&lt;br&gt;toE164Mobile / toE164 (+447…)&lt;br&gt;formatUkPostcode (shared)&lt;br&gt;normaliseCountry&lt;br&gt;&lt;br&gt;&lt;font color="#d5281b"&gt;E: INVALID_MOBILE, INVALID_POSTCODE, UNSUPPORTED_COUNTRY&lt;/font&gt;&lt;br&gt;&lt;font color="#8a5a00"&gt;W: INVALID_PHONE_DROPPED&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="830" width="260" height="320" as="geometry"/></mxCell>
<mxCell id="s3" value='&lt;b&gt;3 · geocode&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;03-geocode.step.ts&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;geocodeStep&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;normalised → geocodedPayloadSchema&lt;/font&gt;&lt;br&gt;&lt;br&gt;deps.lookupPostcode&lt;br&gt;(createPostcodeLookup, 5 s timeout)&lt;br&gt;adds latitude, longitude&lt;br&gt;&lt;br&gt;&lt;font color="#d5281b"&gt;E: POSTCODE_NOT_FOUND, POSTCODE_TERMINATED, GEOCODER_UNAVAILABLE&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="830" width="260" height="320" as="geometry"/></mxCell>
<mxCell id="s4" value='&lt;b&gt;4 · transform&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;04-transform.step.ts&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;transformStep&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;geocoded → transformedFormSchema&lt;/font&gt;&lt;br&gt;&lt;br&gt;camelCase shape&lt;br&gt;splitName: last word = lastName&lt;br&gt;gender other → prefer-not-to-say&lt;br&gt;&lt;br&gt;&lt;font color="#d5281b"&gt;E: NAME_NOT_SPLITTABLE&lt;/font&gt;&lt;br&gt;&lt;font color="#8a5a00"&gt;W: GENDER_MAPPED&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="830" width="260" height="320" as="geometry"/></mxCell>
<mxCell id="s5" value='&lt;b&gt;5 · persist&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;05-persist.step.ts&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;persistStep&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;transformed → { applicationId }&lt;/font&gt;&lt;br&gt;&lt;br&gt;applications.upsertForSubmission&lt;br&gt;(upsert on submissionId)&lt;br&gt;&lt;br&gt;&lt;font color="#d5281b"&gt;E: PERSIST_FAILED&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1330" y="830" width="260" height="320" as="geometry"/></mxCell>
<mxCell id="s6" value='&lt;b&gt;6 · notify&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;06-notify.step.ts&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;notifyStep&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;→ { applicationId, emailId? }&lt;/font&gt;&lt;br&gt;&lt;br&gt;notifier.notifyCompleted: success email via Resend to the Admin → General address (FEAT-003)&lt;br&gt;Never fails the submission&lt;br&gt;&lt;br&gt;&lt;font color="#8a5a00"&gt;skipped: EMAIL_NOT_CONFIGURED, EMAIL_NO_RECIPIENT&lt;/font&gt;&lt;br&gt;&lt;font color="#8a5a00"&gt;W: EMAIL_SEND_FAILED&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1640" y="830" width="260" height="320" as="geometry"/></mxCell>
<mxCell id="e_run_s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;exitX=0.0718;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="runner" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s1_s2" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s2_s3" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s3_s4" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s4_s5" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s5_s6" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ident" value='&lt;b&gt;identityPatch&lt;/b&gt;&lt;br&gt;after validate&lt;br&gt;copies applicationReference, sessionId&lt;br&gt;findEarliestByReference → duplicateOfId, reason &lt;font face="Courier New"&gt;same_reference&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#fff4d6;strokeColor=#8a5a00;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="1190" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="rules" value='&lt;b&gt;On any step error&lt;/b&gt;&lt;br&gt;stop, status = failed, failedStep = step&lt;br&gt;notifier.notifyFailed: failure email (once per attempt)&lt;br&gt;Runner codes: &lt;font face="Courier New"&gt;STEP_INPUT_INVALID&lt;/font&gt;, &lt;font face="Courier New"&gt;STEP_CRASHED&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#fbe9e7;strokeColor=#d5281b;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="1190" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="pcio" value='&lt;b&gt;postcodes.io&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;GET /postcodes/{pc}&lt;/font&gt;&lt;br&gt;404 → &lt;font face="Courier New"&gt;GET /terminated_postcodes/{pc}&lt;/font&gt;&lt;br&gt;no response → GEOCODER_UNAVAILABLE' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#4c6272;align=left;verticalAlign=top;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="1190" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="cont" value="&lt;b&gt;warning and skipped continue&lt;/b&gt;&lt;br&gt;Issues are kept on the step run and returned.&lt;br&gt;Only an error stops the run." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#e6f4ec;strokeColor=#007f3b;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1020" y="1190" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="same" value='&lt;b&gt;samePersonPatch&lt;/b&gt;&lt;br&gt;after persist, if not already linked&lt;br&gt;first + last name and email → &lt;font face="Courier New"&gt;same_person_email&lt;/font&gt;&lt;br&gt;first + last name and mobile → &lt;font face="Courier New"&gt;same_person_mobile&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#fff4d6;strokeColor=#8a5a00;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1330" y="1190" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;IngestSubmission&lt;br&gt;IngestStepRun (one per attempt)&lt;br&gt;Application" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;shape=cylinder3;boundedLbl=1;size=12;fillColor=#f0f4f5;strokeColor=#4c6272;align=center;" vertex="1" parent="1"><mxGeometry x="1640" y="1190" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="e_s1_ident" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#4c6272;strokeWidth=1;dashed=1;" edge="1" parent="1" source="s1" target="ident"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s3_pcio" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#4c6272;strokeWidth=1;" edge="1" parent="1" source="s3" target="pcio"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s5_same" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#4c6272;strokeWidth=1;dashed=1;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="s5" target="same"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s5_db" value="upsert Application" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#4c6272;strokeWidth=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1525" y="1170"/><mxPoint x="1770" y="1170"/></Array></mxGeometry></mxCell>
<mxCell id="laneC" value="3. Response and recovery" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=2;fillColor=none;strokeColor=#aeb7bd;dashed=1;align=left;verticalAlign=top;fontStyle=1;fontColor=#4c6272;" vertex="1" parent="1"><mxGeometry x="60" y="1400" width="1880" height="290" as="geometry"/></mxCell>
<mxCell id="rerun" value='&lt;b&gt;Admin fix and re-run (admin-ingest/submissions.routes.ts)&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;POST /api/admin/submissions/:id/rerun { fromStep? }&lt;/font&gt; → pipeline.rerun&lt;br&gt;Starts at fromStep ?? failedStep ?? validate. Input = last non-error output of the previous step, so earlier steps and the geocoder are not repeated. attempts + 1.&lt;br&gt;&lt;font face="Courier New"&gt;POST /api/admin/submissions/rerun-failed { step }&lt;/font&gt; → rerunFailedAt&lt;br&gt;409 CONFLICT if already completed or no usable previous output' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#fff4d6;strokeColor=#8a5a00;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="1450" width="570" height="200" as="geometry"/></mxCell>
<mxCell id="failed" value="&lt;b&gt;status = failed&lt;/b&gt;&lt;br&gt;failedStep = the step that errored&lt;br&gt;lastStep kept" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#fbe9e7;strokeColor=#d5281b;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="710" y="1450" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="resp" value='&lt;b&gt;202 Accepted&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;{ data: { submissionId, status: "completed" | "failed", failedStep: StepName | null, issues: StepIssue[] } }&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;ingestResultDtoSchema (packages/shared). The UI route adds applicationReference.&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#aeb7bd;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1020" y="1450" width="570" height="140" as="geometry"/></mxCell>
<mxCell id="done" value="&lt;b&gt;status = completed&lt;/b&gt;&lt;br&gt;failedStep = null" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#e6f4ec;strokeColor=#007f3b;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1640" y="1450" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="e_rules_failed" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#d5281b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rules" target="failed"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="1390"/><mxPoint x="840" y="1390"/></Array></mxGeometry></mxCell>
<mxCell id="e_s6_done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#007f3b;strokeWidth=2;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s6" target="done"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1920" y="990"/><mxPoint x="1920" y="1510"/></Array></mxGeometry></mxCell>
<mxCell id="e_failed_resp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="failed" target="resp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_done_resp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="done" target="resp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_rerun_run" value="re-run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#8a5a00;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;entryX=0.1575;entryY=1;" edge="1" parent="1" source="rerun" target="runner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="laneD" value="4. Submission states, spec drift, legend" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=2;fillColor=none;strokeColor=#aeb7bd;dashed=1;align=left;verticalAlign=top;fontStyle=1;fontColor=#4c6272;" vertex="1" parent="1"><mxGeometry x="60" y="1730" width="1880" height="410" as="geometry"/></mxCell>
<mxCell id="drift" value='&lt;b&gt;FEAT-001 spec vs code (full list: ai-context/guides/backend/api-architecture.md)&lt;/b&gt;&lt;br&gt;• &lt;font face="Courier New"&gt;runPipeline()&lt;/font&gt; is &lt;font face="Courier New"&gt;createPipelineRunner()&lt;/font&gt; returning run, rerun, rerunFailedAt&lt;br&gt;• Enums are lowercase (received, success, api), not RECEIVED / SUCCESS / API&lt;br&gt;• Each step declares an input Zod schema; the runner re-checks it (STEP_INPUT_INVALID)&lt;br&gt;• STEP_CRASHED catch-all added&lt;br&gt;• Re-run accepts fromStep and returns 409 when it cannot resume&lt;br&gt;• Duplicates also match the same person (name + email or mobile) after persist&lt;br&gt;• Emails (FEAT-003): notify sends the success email, the runner the failure email&lt;br&gt;• /api/v1/intake (UI) joins the same pipeline and rate limits before the body limit' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#fff4d6;strokeColor=#8a5a00;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="1780" width="900" height="330" as="geometry"/></mxCell>
<mxCell id="st_r" value="&lt;b&gt;received&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#aeb7bd;align=left;verticalAlign=top;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="1790" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="st_p" value="&lt;b&gt;processing&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#aeb7bd;align=left;verticalAlign=top;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="1790" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="st_c" value="&lt;b&gt;completed&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#e6f4ec;strokeColor=#007f3b;align=left;verticalAlign=top;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="1790" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="st_f" value="&lt;b&gt;failed&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#fbe9e7;strokeColor=#d5281b;align=left;verticalAlign=top;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="1890" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="e_st_rp" value="run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#005eb8;strokeWidth=2;" edge="1" parent="1" source="st_r" target="st_p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_st_pc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#007f3b;strokeWidth=2;" edge="1" parent="1" source="st_p" target="st_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_st_pf" value="step error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#d5281b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="st_p" target="st_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_st_fp" value="re-run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#8a5a00;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.25;entryY=1;" edge="1" parent="1" source="st_f" target="st_p"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="1970"/><mxPoint x="1350" y="1970"/></Array></mxGeometry></mxCell>
<mxCell id="legend" value='&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color="#005eb8"&gt;Blue&lt;/font&gt;: main path · &lt;font color="#d5281b"&gt;Red&lt;/font&gt;: failure · &lt;font color="#007f3b"&gt;Green&lt;/font&gt;: success · &lt;font color="#8a5a00"&gt;Amber&lt;/font&gt;: duplicates, re-run, notes&lt;br&gt;E: error code (stops the run) · W: warning code (continues) · skipped: step did nothing, run continues' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#aeb7bd;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1020" y="2000" width="880" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
