<mxfile host="drawio" type="device"><diagram id="ingest-api-flow" name="ingest-api-flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b&gt;POST /api/v1/ingest: from supplier request to stored application&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;Code as of the root commit. Paths are under apps/api/src/features/ unless noted.&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;text;fontSize=24;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1500" height="50" as="geometry"/></mxCell>
<mxCell id="laneA" value="1. Transport: ingest-api/ingest.routes.ts (createIngestRoutes), intake-api/intake.routes.ts" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=2;fillColor=none;strokeColor=#aeb7bd;dashed=1;align=left;verticalAlign=top;fontStyle=1;fontColor=#4c6272;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="1880" height="490" as="geometry"/></mxCell>
<mxCell id="sup" value='&lt;b&gt;Third-party supplier&lt;/b&gt;&lt;br&gt;POST /api/v1/ingest&lt;br&gt;&lt;font face="Courier New"&gt;Authorization: Bearer ifk_…&lt;/font&gt;&lt;br&gt;JSON body (snake_case)' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#f0f4f5;strokeColor=#4c6272;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="230" height="140" as="geometry"/></mxCell>
<mxCell id="body" value='&lt;b&gt;bodyLimit&lt;/b&gt;&lt;br&gt;64 KB&lt;br&gt;&lt;font face="Courier New"&gt;MAX_INGEST_BODY_BYTES&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#e8f1fa;strokeColor=#005eb8;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="230" height="140" as="geometry"/></mxCell>
<mxCell id="ip" value='&lt;b&gt;rateLimit(ipLimiter)&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;ip:&amp;lt;ip&amp;gt;&lt;/font&gt;&lt;br&gt;20 requests / 60 s' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#e8f1fa;strokeColor=#005eb8;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="180" width="230" height="140" as="geometry"/></mxCell>
<mxCell id="auth" value="&lt;b&gt;ApiKeyAuthService.authenticate&lt;/b&gt;&lt;br&gt;hashApiKey (SHA-256)&lt;br&gt;→ findKeyByHash&lt;br&gt;→ apiKeyStatus&lt;br&gt;→ touchKey (lastUsedAt)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#e8f1fa;strokeColor=#005eb8;align=center;" vertex="1" parent="1"><mxGeometry x="1020" y="180" width="230" height="140" as="geometry"/></mxCell>
<mxCell id="key" value='&lt;b&gt;rateLimit(keyLimiter)&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;key:&amp;lt;apiKeyId&amp;gt;&lt;/font&gt;&lt;br&gt;60 requests / 60 s' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#e8f1fa;strokeColor=#005eb8;align=center;" vertex="1" parent="1"><mxGeometry x="1330" y="180" width="230" height="140" as="geometry"/></mxCell>
<mxCell id="recv" value="&lt;b&gt;IngestService.receive&lt;/b&gt;&lt;br&gt;submissions.create({ source: 'api', rawBody, providerId, apiKeyId })&lt;br&gt;raw text stored as received&lt;br&gt;status = &lt;b&gt;received&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#4c6272;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1640" y="180" width="260" height="140" as="geometry"/></mxCell>
