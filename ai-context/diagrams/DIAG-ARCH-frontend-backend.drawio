<mxCell id="ocr" value="&lt;b&gt;OCR sidecar&lt;/b&gt;&lt;br&gt;POST /ocr from the extract service, only when the PDF has fewer than 3 fields or is a photo&lt;br&gt;127.0.0.1:8307, optional" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#4c6272;align=left;verticalAlign=top;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2150" y="1580" width="220" height="140" as="geometry"/></mxCell>
