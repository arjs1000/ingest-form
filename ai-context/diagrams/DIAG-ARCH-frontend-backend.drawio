<mxCell id="e_pipe_pcio" value="GET /postcodes/{pc}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#4c6272;strokeWidth=1;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="pipe" target="pcio"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1760" y="1717"/><mxPoint x="1760" y="1795"/></Array></mxGeometry></mxCell>
<mxCell id="e_pipe_resend" value="SubmissionNotifier" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#4c6272;strokeWidth=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="pipe" target="resend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="1935"/></Array></mxGeometry></mxCell>
<mxCell id="runtime" value='&lt;b&gt;Two runtimes, one app&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;server.ts&lt;/font&gt; (Node, dev): builds createApp(buildDeps(config)) once; in-memory rate limiters.&lt;br&gt;&lt;font face="Courier New"&gt;worker.ts&lt;/font&gt; (Cloudflare Workers): builds the app per request, ratelimits bindings, disconnects Prisma via ctx.waitUntil(dispose()).&lt;br&gt;&lt;font face="Courier New"&gt;#prisma&lt;/font&gt; resolves to the Node or workerd client. buildDeps() in app.ts is the only place that creates services and repositories.&lt;br&gt;Without DATABASE_URL, /api/v1/ingest, POST /api/v1/intake and /api/admin/* (except settings) answer 503.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#aeb7bd;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="2040" width="900" height="180" as="geometry"/></mxCell>
<mxCell id="upload" value="&lt;b&gt;Uploaded file bytes: memory only, never stored&lt;/b&gt;&lt;br&gt;FilePond → POST /api/v1/intake/extract (multipart) → file.arrayBuffer() → detectFileType → readPdfWords, then OCR sidecar if fewer than 3 fields → fields returned → bytes dropped.&lt;br&gt;No bucket, no presigned URLs, no file table. The file name lives only in the browser draft store." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#fff4d6;strokeColor=#8a5a00;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1040" y="2040" width="620" height="180" as="geometry"/></mxCell>
<mxCell id="legend" value='&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color="#005eb8"&gt;Blue arrows&lt;/font&gt;: HTTP request path&lt;br&gt;Grey arrows: data access (Prisma) or outbound HTTP&lt;br&gt;Dashed: optional or not built&lt;br&gt;Blue-bordered box: Hono router · Cylinder: tables touched&lt;br&gt;Admin routes have no authentication in this POC' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#aeb7bd;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1710" y="2040" width="680" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
