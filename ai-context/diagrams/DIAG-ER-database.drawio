<mxfile host="drawio" type="device"><diagram id="database-schema" name="database-schema"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b&gt;Database schema (apps/api/prisma/schema.prisma)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;PostgreSQL: Docker on 8303 locally, Neon in the cloud. 7 models, 6 enums, 4 migrations.&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;text;fontSize=24;fontStyle=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1500" height="50" as="geometry"/></mxCell>
<mxCell id="prov" value='&lt;b style="font-size:16px"&gt;IngestProvider&lt;/b&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;PK uuid()&lt;/font&gt;&lt;br&gt;&lt;b&gt;name&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;unique&lt;/font&gt;&lt;br&gt;&lt;b&gt;createdAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;now()&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="340" height="150" as="geometry"/></mxCell>
<mxCell id="key" value='&lt;b style="font-size:16px"&gt;IngestApiKey&lt;/b&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;PK uuid()&lt;/font&gt;&lt;br&gt;&lt;b&gt;providerId&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;FK → IngestProvider&lt;/font&gt;&lt;br&gt;&lt;b&gt;label&lt;/b&gt; &lt;font face="Courier New"&gt;String?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;prefix&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;12-char display prefix&lt;/font&gt;&lt;br&gt;&lt;b&gt;keyHash&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;unique, SHA-256&lt;/font&gt;&lt;br&gt;&lt;b&gt;createdAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;expiresAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;+30 days&lt;/font&gt;&lt;br&gt;&lt;b&gt;lastUsedAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;revokedAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;index (providerId). Full key never stored.&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="90" y="440" width="340" height="340" as="geometry"/></mxCell>
<mxCell id="sub" value='&lt;b style="font-size:16px"&gt;IngestSubmission&lt;/b&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;PK uuid()&lt;/font&gt;&lt;br&gt;&lt;b&gt;source&lt;/b&gt; &lt;font face="Courier New"&gt;SubmissionSource&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;api | ui&lt;/font&gt;&lt;br&gt;&lt;b&gt;providerId&lt;/b&gt; &lt;font face="Courier New"&gt;String?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;FK → IngestProvider&lt;/font&gt;&lt;br&gt;&lt;b&gt;apiKeyId&lt;/b&gt; &lt;font face="Courier New"&gt;String?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;FK → IngestApiKey&lt;/font&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;font face="Courier New"&gt;SubmissionStatus&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;default received&lt;/font&gt;&lt;br&gt;&lt;b&gt;lastStep&lt;/b&gt; &lt;font face="Courier New"&gt;StepName?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;failedStep&lt;/b&gt; &lt;font face="Courier New"&gt;StepName?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;rawBody&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;body text as received (patient data)&lt;/font&gt;&lt;br&gt;&lt;b&gt;applicationReference&lt;/b&gt; &lt;font face="Courier New"&gt;String?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;sessionId&lt;/b&gt; &lt;font face="Courier New"&gt;String?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;duplicateOfId&lt;/b&gt; &lt;font face="Courier New"&gt;String?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;self FK&lt;/font&gt;&lt;br&gt;&lt;b&gt;duplicateReason&lt;/b&gt; &lt;font face="Courier New"&gt;DuplicateReason?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;attempts&lt;/b&gt; &lt;font face="Courier New"&gt;Int&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;default 1&lt;/font&gt;&lt;br&gt;&lt;b&gt;receivedAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;now()&lt;/font&gt;&lt;br&gt;&lt;b&gt;updatedAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;@updatedAt&lt;/font&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;indexes: applicationReference · (status, failedStep) · receivedAt · duplicateOfId&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="440" height="470" as="geometry"/></mxCell>
<mxCell id="run" value='&lt;b style="font-size:16px"&gt;IngestStepRun&lt;/b&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;PK uuid()&lt;/font&gt;&lt;br&gt;&lt;b&gt;submissionId&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;FK → IngestSubmission&lt;/font&gt;&lt;br&gt;&lt;b&gt;step&lt;/b&gt; &lt;font face="Courier New"&gt;StepName&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;attempt&lt;/b&gt; &lt;font face="Courier New"&gt;Int&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;font face="Courier New"&gt;StepRunStatus&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;output&lt;/b&gt; &lt;font face="Courier New"&gt;Json?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;null on error&lt;/font&gt;&lt;br&gt;&lt;b&gt;issues&lt;/b&gt; &lt;font face="Courier New"&gt;Json&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;StepIssue[]&lt;/font&gt;&lt;br&gt;&lt;b&gt;durationMs&lt;/b&gt; &lt;font face="Courier New"&gt;Int&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;startedAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;now()&lt;/font&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;index (submissionId, step). One row per step per attempt.&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1130" y="150" width="380" height="340" as="geometry"/></mxCell>
<mxCell id="app" value='&lt;b style="font-size:16px"&gt;Application&lt;/b&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;PK uuid()&lt;/font&gt;&lt;br&gt;&lt;b&gt;submissionId&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;unique FK (1:1)&lt;/font&gt;&lt;br&gt;&lt;b&gt;sessionId&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;applicationReference&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;firstName&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;lastName&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;email&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;gender&lt;/b&gt; &lt;font face="Courier New"&gt;Gender&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;dateOfBirth&lt;/b&gt; &lt;font face="Courier New"&gt;Date&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;phoneNumber&lt;/b&gt; &lt;font face="Courier New"&gt;String?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;mobileNumber&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;E.164&lt;/font&gt;&lt;br&gt;&lt;b&gt;addressLine1..3&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;line 3 optional&lt;/font&gt;&lt;br&gt;&lt;b&gt;postcode&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;country&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;latitude, longitude&lt;/b&gt; &lt;font face="Courier New"&gt;Float&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;postcodes.io&lt;/font&gt;&lt;br&gt;&lt;b&gt;createdAt, updatedAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;indexes: applicationReference · (lastName, firstName). Written by the persist step.&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1130" y="560" width="380" height="490" as="geometry"/></mxCell>
<mxCell id="set" value='&lt;b style="font-size:16px"&gt;IntakeSettings&lt;/b&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;PK, always "default"&lt;/font&gt;&lt;br&gt;&lt;b&gt;acceptPhotos&lt;/b&gt; &lt;font face="Courier New"&gt;Boolean&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;maxFileSizeMb&lt;/b&gt; &lt;font face="Courier New"&gt;Int&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;5 | 10 | 25&lt;/font&gt;&lt;br&gt;&lt;b&gt;updatedAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;Single row, created on first save. No relations.&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1600" y="150" width="320" height="240" as="geometry"/></mxCell>
<mxCell id="notif" value='&lt;b style="font-size:16px"&gt;NotificationSettings&lt;/b&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;font face="Courier New"&gt;String&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;PK, always "default"&lt;/font&gt;&lt;br&gt;&lt;b&gt;successEmail&lt;/b&gt; &lt;font face="Courier New"&gt;String?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;failureEmail&lt;/b&gt; &lt;font face="Courier New"&gt;String?&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;updatedAt&lt;/b&gt; &lt;font face="Courier New"&gt;DateTime&lt;/font&gt; &lt;font style="font-size:14px" color="#4c6272"&gt;&lt;/font&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;Admin → General addresses for FEAT-003 emails. No relations.&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#005eb8;align=left;verticalAlign=top;strokeWidth=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1600" y="440" width="320" height="240" as="geometry"/></mxCell>
<mxCell id="enums" value='&lt;b style="font-size:16px"&gt;Enums&lt;/b&gt;&lt;br&gt;&lt;hr size="1"&gt;&lt;br&gt;&lt;b&gt;SubmissionSource&lt;/b&gt;: api, ui&lt;br&gt;&lt;b&gt;SubmissionStatus&lt;/b&gt;: received, processing, completed, failed&lt;br&gt;&lt;b&gt;StepName&lt;/b&gt;: validate, normalise, geocode, transform, persist, notify&lt;br&gt;&lt;b&gt;StepRunStatus&lt;/b&gt;: success, warning, error, skipped&lt;br&gt;&lt;b&gt;DuplicateReason&lt;/b&gt;: same_reference, same_person_email, same_person_mobile&lt;br&gt;&lt;b&gt;Gender&lt;/b&gt;: male, female, prefer_not_to_say (stored "prefer-not-to-say")' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#f0f4f5;strokeColor=#4c6272;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1600" y="720" width="320" height="330" as="geometry"/></mxCell>
