<mxCell id="mig" value='&lt;b&gt;Migrations (apps/api/prisma/migrations/)&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;20260927164756_ingest_pipeline&lt;/font&gt;: providers, keys, submissions, step runs, applications&lt;br&gt;&lt;font face="Courier New"&gt;20260929084727_duplicate_person_matching&lt;/font&gt;: duplicateReason, duplicateOfId becomes a self FK (SetNull)&lt;br&gt;&lt;font face="Courier New"&gt;20260929104642_intake_settings&lt;/font&gt;: IntakeSettings row&lt;br&gt;&lt;font face="Courier New"&gt;20260929141148_notification_settings&lt;/font&gt;: NotificationSettings row&lt;br&gt;&lt;font style="font-size:14px" color="#4c6272"&gt;No table stores uploaded files or file metadata. Uploads are read in memory and dropped.&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#fff4d6;strokeColor=#8a5a00;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="1160" width="860" height="170" as="geometry"/></mxCell>
<mxCell id="clients" value='&lt;b&gt;Two generated clients, one schema&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;src/generated/prisma&lt;/font&gt; (Node: dev server, tests) and &lt;font face="Courier New"&gt;src/generated/prisma-worker&lt;/font&gt; (workerd)&lt;br&gt;Code imports &lt;font face="Courier New"&gt;#prisma&lt;/font&gt;; package.json imports picks one by runtime condition.&lt;br&gt;core/db/prisma.ts: PrismaNeon for *.neon.tech hosts, PrismaPg otherwise.&lt;br&gt;Only repositories import Prisma: prisma-submission, prisma-application, prisma-provider, intake-settings, notification-settings.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#212b32;spacing=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#aeb7bd;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="1160" width="920" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
